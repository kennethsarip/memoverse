# Supabase connection for the app. EXPO_PUBLIC_* vars are inlined into the client
# bundle at build time, so only put PUBLIC (anon) values here. Never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# For local development against `npx supabase start`, use the values it prints:
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<local anon key from `supabase start`>
